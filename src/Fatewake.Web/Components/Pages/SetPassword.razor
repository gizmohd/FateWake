@page "/set-password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Set a local password - Fatewake</PageTitle>
<main class="account-page">
    <h1>Set a local password</h1>
    <p>Add a password so you can sign in with your email if your external provider is unavailable. Use 12-128 characters.</p>
    @if (Error is not null)
    {
        <p role="alert">Unable to set the password. Check the length and confirmation. A password already configured cannot be overwritten here.</p>
    }
    <form method="post" action="/auth/set-password">
        <AntiforgeryToken />
        <label>Password <input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <label>Confirm password <input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <button type="submit">Set password</button>
    </form>
    <p><a href="/account">Back to account</a></p>
</main>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
