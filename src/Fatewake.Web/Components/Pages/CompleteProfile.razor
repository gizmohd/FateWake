@page "/complete-profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Complete your profile - @BrandIdentity.GameName</PageTitle>
<main class="account-page">
    <h1>Complete your profile</h1>
    <p>Finish setting up your account with your name and location. These details are separate from your Pathweaver's identity.</p>
    @if (Error is not null)
    {
        <p role="alert">@(Error == "invalid"
            ? "Enter your first name, last name, city, and state/region, using up to 100 characters for each."
            : "Your profile could not be saved. Please try again.")</p>
    }
    <form method="post" action="/auth/complete-profile">
        <AntiforgeryToken />
        <label>First name <input type="text" name="firstName" autocomplete="given-name" maxlength="100" required /></label>
        <label>Last name <input type="text" name="lastName" autocomplete="family-name" maxlength="100" required /></label>
        <label>City <input type="text" name="city" autocomplete="address-level2" maxlength="100" required /></label>
        <label>State/region <input type="text" name="state" autocomplete="address-level1" maxlength="100" required /></label>
        <button type="submit">Save and continue</button>
    </form>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
