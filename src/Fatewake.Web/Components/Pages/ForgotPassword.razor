@page "/forgot-password"

<PageTitle>Forgot password - @BrandIdentity.GameName</PageTitle>
<main class="account-page">
    <h1>Reset your password</h1>
    @if (Sent)
    {
        <p role="status">If this email belongs to an eligible account, you’ll receive a reset link. Check your spam folder if it doesn’t arrive.</p>
    }
    @if (Error is not null)
    {
        <p role="alert">@(Error == "limited" ? "Too many attempts. Wait a minute before trying again." : "The request could not be completed. Try again.")</p>
    }
    <form method="post" action="/auth/forgot-password">
        <AntiforgeryToken />
        <label>Email <input type="email" name="email" autocomplete="username" maxlength="254" required /></label>
        <button>Send reset link</button>
    </form>
    <p><a href="/login">Back to sign in</a></p>
</main>

@code {
    [SupplyParameterFromQuery(Name = "sent")] public bool Sent { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
