@page "/"
@using Fatewake.Web.Presentation
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@BrandIdentity.GameName — @BrandIdentity.Tagline</PageTitle>
<HeadContent>
    <meta name="description" content="Pathweaver is an episodic science-fiction narrative adventure in The Wayfinder Universe. Every choice shapes reality." />
    <meta property="og:site_name" content="@BrandIdentity.GameName" />
    <meta property="og:title" content="@BrandIdentity.Tagline" />
    <meta property="og:description" content="There are those who find the path. And those who weave it." />
    <meta property="og:url" content="@BrandIdentity.PublicUrl" />
    <link rel="canonical" href="@BrandIdentity.PublicUrl" />
</HeadContent>

<main class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-title">
        <p class="landing-kicker">FROM THE UNIVERSE OF THE WAYFINDER&rsquo;S HEIR</p>
        <h1 id="landing-title">@BrandIdentity.GameName</h1>
        <p class="landing-intro">There are those who find the path.<br />And those who weave it.</p>
        <p class="landing-intro"><strong>@BrandIdentity.Tagline</strong></p>
        <p class="landing-note">An episodic science-fiction narrative adventure in @BrandIdentity.Franchise.</p>
        <div class="landing-actions">
            <a class="landing-primary" href="/play">Start playing</a>
            <AuthorizeView>
                <NotAuthorized>
                    <a class="landing-secondary" href="/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <p class="landing-note">Start as a guest, or create an account to keep your Pathweaver and their story tied to your account.</p>
    </section>

    <section class="landing-section" aria-labelledby="story-title">
        <div class="landing-section-heading">
            <p class="landing-kicker">CURRENTLY AVAILABLE</p>
            <h2 id="story-title">@GameGuideCatalog.CurrentStoryTitle</h2>
        </div>
        <div class="landing-story-card">
            <p class="landing-story-meta">CHAPTER @GameGuideCatalog.CurrentStoryDay · @GameGuideCatalog.CurrentStoryBeatCount STORY BEATS</p>
            <p>@GameGuideCatalog.Introduction</p>
            <p>Begin at an assigned place and time on the morning of The Silence. Read the scene, decide how you respond, and see the authoritative game outcome unfold.</p>
            <a href="/play">Enter the story <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <section class="landing-section" aria-labelledby="getting-started-title">
        <p class="landing-kicker">GETTING STARTED</p>
        <h2 id="getting-started-title">Your first few minutes</h2>
        <div class="landing-guide-grid">
            <article class="landing-guide-card">
                <span class="landing-step">01</span>
                <h3>Start the opening</h3>
                <p>Choose <strong>Start playing</strong> to continue as your Pathweaver or begin as a guest. No setup is required.</p>
            </article>
            <article class="landing-guide-card">
                <span class="landing-step">02</span>
                <h3>Read the scene</h3>
                <p>Move through the opening beats at your own pace. The story presents the people and events your Pathweaver can currently observe.</p>
            </article>
            <article class="landing-guide-card">
                <span class="landing-step">03</span>
                <h3>Choose how to respond</h3>
                <p>Select an authored action or describe another response. The game engine determines consequences; narration presents what happened.</p>
            </article>
        </div>
    </section>

    <section class="landing-section landing-appearance" aria-labelledby="appearance-title">
        <div>
            <p class="landing-kicker">YOUR PATHWEAVER</p>
            <h2 id="appearance-title">A character shaped by the story</h2>
        </div>
        <p>@GameGuideCatalog.CharacterAppearanceStatus</p>
    </section>

    <section class="landing-section" aria-labelledby="threads-title">
        <p class="landing-kicker">CHAPTERS · ACTS · THREADS</p>
        <h2 id="threads-title">A reality shaped by your choices</h2>
        <p>Chapters form the daily story. Major arcs are Acts. Alternate realities are Threads, each carrying its own choices and consequences.</p>
        <p>Convergences bring compatible Threads together. Shared-world Convergences remain a planned feature; the opening currently follows your personal story.</p>
    </section>

    <footer class="landing-footer">
        <span>PATHWEAVER · THE WAYFINDER UNIVERSE</span>
        <a href="@BrandIdentity.PublicUrl">THEPATHWEAVER.COM</a>
        <a href="/play">Play the opening</a>
    </footer>
</main>
