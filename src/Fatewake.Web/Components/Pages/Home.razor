@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Fatewake.Web.Presentation
@using Fatewake.Web.Components.Presentation
@inject Fatewake.Web.Authentication.AuthenticatedApiClient ApiClient
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Fatewake — The Silence</PageTitle>
<main class="scene">
<nav aria-label="Account">
    <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        <Authorized><a href="/account">@context.User.Identity?.Name</a></Authorized>
        <NotAuthorized><a href="/login">Sign in</a> | <a href="/register">Create an account</a></NotAuthorized>
    </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
</nav>
<section class="episode">
@if(_error is not null){<div class="interaction" role="alert">@_error <a href="/login">Sign in again</a> or <a href="/">reload</a>.</div>}
else if(!_ready){<div class="interaction"><div class="wake">REMEMBERING…</div></div>}
else
{
    <ArtCompositionView ArtworkKey="@Beat.ArtworkKey" Layers="@DayOneArt.For(Beat.ArtworkKey)">
        <div class="panel-overlay">
            <div class="panel-label">THE SILENCE · SURVIVOR DAY 1</div>
            @if(Beat.Time is not null){<div class="beat-time">@Beat.Time</div>}
            @if(Beat.Status is not null){<div class="signal">@Beat.Status</div>}
            <div class="panel-spacer"></div>
            @if(Beat.Narration is not null){<div class="caption">@Beat.Narration</div>}
            @if(Beat.Dialogue is not null){<div class="dialogue"><div class="speaker">@Beat.Dialogue.Speaker</div><div class="line">“@Beat.Dialogue.Text”</div></div>}
        </div>
    </ArtCompositionView>
    <div class="interaction">
        @if(Beat.Kind==BeatKind.Interaction)
        {
            <div class="choices">
            @foreach(var choice in Beat.Interactions.Where(x=>!x.AllowFreeform))
            { <button disabled="@_submitting" @onclick="()=>Act(choice.ActionType)">@choice.Label</button> }
            </div>
            <button class="other-toggle" disabled="@_submitting" @onclick="()=>_showOther=!_showOther">Do something else…</button>
            @if(_showOther){<div class="composer"><textarea @bind="_freeform" placeholder="What do you do?"></textarea><button disabled="@(_submitting||string.IsNullOrWhiteSpace(_freeform))" @onclick="SubmitFreeform">Do it</button></div>}
        }
        else
        {
            @if(Beat.Kind==BeatKind.Consequence && !string.IsNullOrWhiteSpace(_resolutionText)){<div class="result-inline">@_resolutionText</div>}
            <button class="continue" disabled="@_submitting" @onclick="NextBeat">Continue</button>
        }
        <div class="beat-progress">@(_beatIndex+1) / @Scene.Beats.Count</div>
    </div>
}
</section>
</main>

@code {
    private static SceneDefinition Scene=>DayOneScenes.Opening;
    private BeatDefinition Beat=>Scene.Beats[Math.Clamp(_beatIndex,0,Scene.Beats.Count-1)];
    private bool _ready,_showOther,_submitting; private int _beatIndex; private string _freeform="",_resolutionText="";
    private SessionDto? _session; private Guid? _inflightKey;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;
        try
        {
        Guid? survivorId=null;
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        if(user.Identity?.IsAuthenticated!=true)
        {
            var saved=await JS.InvokeAsync<string?>("localStorage.getItem","fatewake.survivorId");
            if(Guid.TryParse(saved,out var parsed))survivorId=parsed;
        }
        using var client=await ApiClient.CreateAsync();
        using var response=await StartSessionAsync(client,survivorId);
        response.EnsureSuccessStatusCode();
        _session=await response.Content.ReadFromJsonAsync<SessionDto>();
        if(_session is not null)
        {
            if(user.Identity?.IsAuthenticated!=true)
                await JS.InvokeVoidAsync("localStorage.setItem","fatewake.survivorId",_session.SurvivorId.ToString());
            _beatIndex=Scene.IndexOf(_session.BeatKey);
            if(!string.IsNullOrWhiteSpace(_session.LastOutcome))_resolutionText=OutcomeText(_session.LastOutcome);
        }
        _ready=true;StateHasChanged();
        }
        catch(HttpRequestException ex){Logger.LogWarning(ex,"Session loading failed");_error="Unable to load your session.";StateHasChanged();}
    }

    private async Task NextBeat()
    {
        if(_beatIndex>=Scene.Beats.Count-1)return;
        try
        {
            _beatIndex++;_showOther=false;await SaveProgressAsync();StateHasChanged();
        }
        catch(HttpRequestException ex){Logger.LogWarning(ex,"Presentation progress could not be saved");_error="Unable to save your progress. Your session may have expired.";}
    }

    private static async Task<HttpResponseMessage> StartSessionAsync(HttpClient client,Guid? survivorId)
    {
        var response=await client.PostAsJsonAsync("/api/session/start",new{SurvivorId=survivorId,BroadRegion="unknown"});
        if(response.StatusCode==System.Net.HttpStatusCode.NotFound && survivorId is not null)
        {
            response.Dispose();
            return await client.PostAsJsonAsync("/api/session/start",new{SurvivorId=(Guid?)null,BroadRegion="unknown"});
        }
        return response;
    }

    private Task SubmitFreeform()=>Act("freeform",_freeform);

    private async Task Act(string actionType,string? rawInput=null)
    {
        if(_submitting||_session is null)return;
        _submitting=true;_inflightKey??=Guid.NewGuid();
        try
        {
            using var client=await ApiClient.CreateAsync();
            var payload=new{_session.EventInstanceId,_session.SurvivorId,_session.TimelineId,IdempotencyKey=_inflightKey.Value,
                Action=new{ActionType=actionType,Arguments=new Dictionary<string,string>(),RawInput=rawInput}};
            using var response=await client.PostAsJsonAsync("/api/day1/resolve",payload);
            response.EnsureSuccessStatusCode();
            var result=await response.Content.ReadFromJsonAsync<ResolutionDto>();
            if(result?.Accepted==true)
            {
                _resolutionText=OutcomeText(result.OutcomeKey);_inflightKey=null;
                _beatIndex=Scene.IndexOf("choice-wake");await SaveProgressAsync();
            }
        }
        catch(HttpRequestException ex){Logger.LogWarning(ex,"Player action could not be saved");_error="Unable to save your choice. Your session may have expired.";}
        finally{_submitting=false;}
    }

    private async Task SaveProgressAsync()
    {
        if(_session is null)return;
        using var client=await ApiClient.CreateAsync();
        using var response=await client.PostAsJsonAsync("/api/session/progress",new{_session.SurvivorId,_session.EventInstanceId,SceneKey=Scene.Key,BeatKey=Beat.Key});
        response.EnsureSuccessStatusCode();
    }

    private static string OutcomeText(string key)=>key switch{
        "helped_maya"=>"You cross the threshold and take some of the stranger's weight. Maya notices that you moved before you had all the answers.",
        "called_from_safety"=>"You keep the doorway between you and the street and call out. Michelle hears the caution in it.",
        "stayed_inside"=>"You remain behind the glass and watch. Michelle eventually looks away.",
        "investigated_radio"=>"You turn from the window toward the radio. Information feels safer than stepping outside.",
        _=>"The world absorbs what you chose."
    };

    private sealed record SessionDto(Guid SurvivorId,Guid TimelineId,Guid EventInstanceId,int SurvivorDay,string EventKey,string Status,string? LastOutcome,Dictionary<string,string> NarrativeFacts,string SceneKey,string BeatKey);
    private sealed record ResolutionDto(bool Accepted,string OutcomeKey);
}
