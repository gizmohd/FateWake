@page "/play"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Fatewake.GameEngine
@using Fatewake.Infrastructure.Story
@using Fatewake.Web.Presentation
@using Fatewake.Web.Components.Presentation
@inject Fatewake.Web.Authentication.AuthenticatedApiClient ApiClient
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger
@implements IDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Hosting.IHostEnvironment Environment

<PageTitle>@BrandIdentity.GameName — The Silence</PageTitle>
<SiteShell SurvivorId="_session?.SurvivorId">
    <Chapter>
        <div class="play-chapter">
            <h1>@(_generated?.Scene?.Title ?? Scene.Title)</h1>
            <span>Chapter @(_session?.SurvivorDay ?? Scene.SurvivorDay)</span>
        </div>
    </Chapter>

    <MenuActions>
        @if (!_showGenerated && Environment.IsDevelopment() && _ready && _session is not null)
        {
            <button class="play-reset" type="button" title="Development only: discard this chapter's choices and restart it"
                    disabled="@_submitting" @onclick="ResetChapter">Reset chapter</button>
        }
    </MenuActions>

    <ChildContent>
        <main class="play-episode" aria-label="Current scene">
            @if (_error is not null)
            {
                <div id="play-controls" class="play-frame play-message" role="alert" tabindex="-1">
                    <p>@_error <a href="/login">Sign in again</a> or <a href="/play">reload</a>.</p>
                </div>
            }
            else if (!_ready)
            {
                <div id="play-controls" class="play-frame play-message" role="status" tabindex="-1">Remembering your session…</div>
            }
            else if (_showGenerated)
            {
                @if (_generated?.Scene is { } next)
                {
                    <section class="play-dialogue play-frame" aria-label="Scene text">
                        <div class="play-dialogue-copy">
                            <h2>@next.TimeLabel</h2>
                            @foreach (var beat in next.Beats)
                            {
                                <p>@beat.Narration</p>
                                @if (!string.IsNullOrWhiteSpace(beat.Dialogue))
                                {
                                    <p><strong>@beat.Speaker</strong> “@beat.Dialogue”</p>
                                }
                            }
                        </div>
                    </section>
                }
                <section id="play-controls" class="play-controls play-frame" aria-label="Story controls" tabindex="-1">
                    @if (_actionMessage is not null)
                    {
                        <p class="play-action-alert" role="alert">@_actionMessage</p>
                    }
                    @if (_generated?.Scene is { HasDecision: true } decision)
                    {
                        <h2 id="play-control-title">Choose an action</h2>
                        <ol class="play-choices">
                            @foreach (var choice in decision.Choices.Where(x => !x.AllowFreeform))
                            {
                                <li><button type="button" disabled="@_submitting"
                                            @onclick="() => LoadGeneratedAsync(choice.ActionType)">@choice.Label</button></li>
                            }
                            @CustomChoice
                        </ol>
                        @FreeformComposer
                    }
                    else if (_generated?.Status is "Ready" or "Filtered")
                    {
                        @if (_generated.Status == "Filtered")
                        {
                            <p>This scene is unavailable at your current content level.</p>
                        }
                        <button class="play-primary" type="button" disabled="@_submitting"
                                @onclick="() => LoadGeneratedAsync(advance: true)">@(_generated.Status == "Filtered" ? "Skip scene" : "Continue")</button>
                    }
                    else if (_generated?.Status == "Failed")
                    {
                        <p>Story continuation is unavailable right now.</p>
                        <button class="play-primary" type="button" disabled="@_submitting" @onclick="() => LoadGeneratedAsync(retry: true)">Try again</button>
                    }
                    else
                    {
                        @if (_actionMessage is null)
                        {
                            <p role="status">Preparing your next scene…</p>
                        }
                        <button class="play-primary" type="button" disabled="@_submitting" @onclick="() => LoadGeneratedAsync()">Check for scene</button>
                    }
                    <p><a href="/novel/@_session?.SurvivorId">Read your journal</a></p>
                </section>
            }
            else
            {
                <div class="play-viewport play-frame">
                    <ArtCompositionView ArtworkKey="@Beat.ArtworkKey" Layers="@DayOneArt.For(Beat.ArtworkKey)"
                                        ArtworkDisplayed="RememberArtwork" SurvivorId="_session?.SurvivorId"
                                        PrefetchKeys="UpcomingArtKeys" SelectedActionType="@_selectedActionType">
                        <div class="play-scene-hud">
                            @if (Beat.Time is not null) { <span>@Beat.Time</span> }
                            @if (Beat.Status is not null) { <span class="play-signal">@Beat.Status</span> }
                        </div>
                    </ArtCompositionView>
                </div>

                <section class="play-dialogue play-frame" aria-label="Scene text" aria-live="polite">
                    @if (Beat.Dialogue is { } dialogue)
                    {
                        <div class="play-portrait" aria-hidden="true">
                            <span>@(dialogue.Speaker == "RADIO" ? "RF" : "MS")</span>
                            @if (SpeakerPortrait is { } portrait)
                            {
                                <img @key="portrait" src="@portrait" alt="" />
                            }
                        </div>
                        <div class="play-dialogue-copy">
                            <h2>@dialogue.Speaker</h2>
                            @if (DisplayedNarration is { } narration) { <p class="play-narration">@narration</p> }
                            <p>“@dialogue.Text”</p>
                        </div>
                    }
                    else
                    {
                        <div class="play-dialogue-copy">
                            <h2>@(Beat.Kind == BeatKind.Interaction ? "Your move" : "Narration")</h2>
                            <p>@(DisplayedNarration ?? "What will you do?")</p>
                        </div>
                    }
                </section>

                <section id="play-controls" class="play-controls play-frame" aria-labelledby="play-control-title" tabindex="-1">
                    <div class="play-controls-header">
                        <h2 id="play-control-title">@(Beat.Kind == BeatKind.Interaction ? "Choose an action" : AtChapterEnd ? "Chapter complete" : "Story controls")</h2>
                        <span>Beat @(_beatIndex + 1) / @Scene.Beats.Count</span>
                    </div>
                    @if (Beat.Kind == BeatKind.Interaction)
                    {
                        @if (_actionMessage is not null) { <p class="play-action-alert" role="alert">@_actionMessage</p> }
                        <ol class="play-choices">
                            @foreach (var choice in Beat.Interactions.Where(x => !x.AllowFreeform))
                            {
                                <li><button type="button" disabled="@_submitting" @onclick="() => Act(choice.ActionType)">@choice.Label</button></li>
                            }
                            @CustomChoice
                        </ol>
                        @FreeformComposer
                    }
                    else if (AtChapterEnd)
                    {
                        <p>You’ve reached the end of the opening.</p>
                        <button class="play-primary" type="button" disabled="@_submitting" @onclick="() => LoadGeneratedAsync()">Continue your story</button>
                        @if (_session is not null) { <p><a href="/novel/@_session.SurvivorId">Read your journal</a></p> }
                    }
                    else
                    {
                        <button class="play-primary" type="button" disabled="@_submitting" @onclick="NextBeat"><span aria-hidden="true">▶</span> Continue</button>
                    }
                </section>
            }
        </main>
    </ChildContent>
</SiteShell>
@if (_session is not null) { <StoryToasts @key="_session.SurvivorId" SurvivorId="_session.SurvivorId" /> }

@code {
    private static SceneDefinition Scene => DayOneScenes.Opening;
    private BeatDefinition Beat => Scene.Beats[Math.Clamp(_beatIndex, 0, Scene.Beats.Count - 1)];
    private bool AtChapterEnd => _beatIndex == Scene.Beats.Count - 1;
    private string? SpeakerPortrait =>
        Beat.Dialogue?.Speaker == "MICHELLE SUMMERS" && _artwork?.ArtworkKey == Beat.ArtworkKey &&
        _artwork.Versions.GetValueOrDefault("char-michelle-day1-supporting") is > 0 and var version
            ? $"/art/char-michelle-day1-supporting/{version}/webp"
            : null;
    private bool _ready, _showOther, _submitting, _showGenerated;
    private StorySceneView? _generated;
    private readonly CancellationTokenSource _pageLifetime = new();
    private int _beatIndex;
    private string _freeform = "", _resolutionText = "";
    private string? _selectedActionType;
    private SessionDto? _session;
    private Guid? _inflightKey;
    private string? _error, _actionMessage;
    private ArtworkSnapshot? _artwork;
    private async Task RememberArtwork(ArtworkSnapshot artwork)
    {
        _artwork = artwork;
        if (_session is null || artwork.ArtworkKey != Beat.ArtworkKey)
            return;
        var versions = artwork.Versions.Where(x => x.Value is > 0).ToDictionary(x => x.Key, x => x.Value);
        if (versions.Count == 0)
            return;
        try
        {
            using var client = await ApiClient.CreateAsync();
            using var response = await client.PostAsJsonAsync($"/api/story/{_session.SurvivorId}/artwork",
                new { _session.EventInstanceId, BeatKey = Beat.Key, Versions = versions });
            response.EnsureSuccessStatusCode();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Displayed artwork could not be journaled");
        }
    }

    private string? DisplayedNarration => Beat.Kind == BeatKind.Consequence && !string.IsNullOrWhiteSpace(_resolutionText) ? _resolutionText : Beat.Narration;
    private string[] UpcomingArtKeys => Scene.Beats.Skip(_beatIndex + 1).Take(2)
        .SelectMany(x => DayOneArt.For(x.ArtworkKey)).Select(x => x.AssetKey).Distinct(StringComparer.Ordinal)
        .Except(DayOneArt.For(Beat.ArtworkKey).Select(x => x.AssetKey), StringComparer.Ordinal).Take(16).ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            Guid? survivorId = null;
            var user = await ApiClient.GetCurrentUserAsync();
            if (user.Identity?.IsAuthenticated != true)
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "fatewake.survivorId");
                if (Guid.TryParse(saved, out var parsed))
                    survivorId = parsed;
            }
            using var client = await ApiClient.CreateAsync();
            using var response = await StartSessionAsync(client, survivorId);
            response.EnsureSuccessStatusCode();
            _session = await response.Content.ReadFromJsonAsync<SessionDto>();
            if (_session is not null)
            {
                if (user.Identity?.IsAuthenticated != true)
                    await JS.InvokeVoidAsync("localStorage.setItem", "fatewake.survivorId", _session.SurvivorId.ToString());
                _beatIndex = Scene.IndexOf(_session.BeatKey);
                if (!string.IsNullOrWhiteSpace(_session.LastOutcome))
                    _resolutionText = DayOneOutcomes.Text(_session.LastOutcome, _session.NarrativeFacts);
            }
            _ready = true;
            StateHasChanged();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Session loading failed");
            _error = "Unable to load your session.";
            StateHasChanged();
        }
    }

    private async Task NextBeat()
    {
        if (_submitting || AtChapterEnd)
            return;
        _submitting = true;
        try
        {
            if (Beat.Key == "choice-wake")
                _selectedActionType = null;
            _beatIndex++;
            _showOther = false;
            await SaveProgressAsync();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Presentation progress could not be saved");
            _error = ex.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "Your active Thread changed. Reload to continue without changing another Thread."
                : "Unable to save your progress. Your session may have expired.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static async Task<HttpResponseMessage> StartSessionAsync(HttpClient client,Guid? survivorId)
    {
        var response=await client.PostAsJsonAsync("/api/session/start",new{SurvivorId=survivorId,BroadRegion="unknown"});
        if(response.StatusCode==System.Net.HttpStatusCode.NotFound && survivorId is not null)
        {
            response.Dispose();
            return await client.PostAsJsonAsync("/api/session/start",new{SurvivorId=(Guid?)null,BroadRegion="unknown"});
        }
        return response;
    }

    private RenderFragment CustomChoice => @<li>
        <button type="button" disabled="@_submitting" aria-expanded="@(_showOther ? "true" : "false")"
                @onclick="() => _showOther = !_showOther">Do something else…</button>
    </li>;

    private RenderFragment FreeformComposer => @<div>
        @if (_showOther)
        {
            <div class="play-composer">
                <label for="play-freeform">Describe your action</label>
                <textarea id="play-freeform" @bind="_freeform" @bind:event="oninput"
                          maxlength="@SceneChoiceResolver.MaxFreeformLength" placeholder="What do you do?"></textarea>
                <button class="play-primary" type="button" disabled="@(_submitting || string.IsNullOrWhiteSpace(_freeform))"
                        @onclick="SubmitFreeform">Do it</button>
            </div>
        }
    </div>;

    private Task SubmitFreeform() => _showGenerated
        ? LoadGeneratedAsync(SceneChoiceResolver.Freeform, _freeform)
        : Act(SceneChoiceResolver.Freeform, _freeform);

    private async Task LoadGeneratedAsync(string? actionType = null, string? text = null, bool advance = false, bool retry = false)
    {
        if (_submitting || _session is null)
            return;
        _showGenerated = true;
        _submitting = true;
        _actionMessage = null;
        var ct = _pageLifetime.Token;
        try
        {
            using var client = await ApiClient.CreateAsync();
            var path = $"/api/story/{_session.SurvivorId}/scene";
            if (actionType is not null || advance)
            {
                if (_generated is null)
                    return;
                var endpoint = $"{path}/{_generated.Sequence}/{(advance ? "advance" : "choose")}";
                using var response = await client.PostAsJsonAsync(endpoint, new { ActionType = actionType, RawInput = text }, ct);
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    _actionMessage = StoryContentPolicy.RetryAction;
                    return;
                }
                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                    _generated = await client.GetFromJsonAsync<StorySceneView>(path, ct);
                else
                {
                    response.EnsureSuccessStatusCode();
                    _generated = await response.Content.ReadFromJsonAsync<StorySceneView>(ct);
                }
                _freeform = "";
                _showOther = false;
            }
            else
                _generated = await client.GetFromJsonAsync<StorySceneView>(retry ? path + "?retry=true" : path, ct);

            for (var attempt = 0; attempt < 15 && _generated?.Status == "Pending"; attempt++)
            {
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(2), ct);
                _generated = await client.GetFromJsonAsync<StorySceneView>(path, ct);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Story continuation could not be loaded");
            _actionMessage = "Unable to load the next scene. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        _pageLifetime.Cancel();
        _pageLifetime.Dispose();
    }

    private async Task ResetChapter()
    {
        if (_submitting || _session is null || !Environment.IsDevelopment())
            return;
        _submitting = true;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Reset this chapter? Your choices in it will be discarded."))
                return;
            using var client=await ApiClient.CreateAsync();
            using var response=await client.PostAsJsonAsync("/api/debug/session/reset-chapter",new{_session.SurvivorId,_session.EventInstanceId});
            response.EnsureSuccessStatusCode();
            _session=await response.Content.ReadFromJsonAsync<SessionDto>()??_session;
            _beatIndex = Scene.IndexOf(_session.BeatKey);
            _resolutionText = "";
            _freeform = "";
            _showOther = false;
            _inflightKey = null;
            _error = null;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Development chapter reset failed");
            _error = ex.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "This chapter has preserved Threads. Start a fresh Chapter 1 Thread instead."
                : "Unable to reset the chapter.";
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Chapter reset confirmation could not be displayed");
            _error = "Unable to confirm the chapter reset.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task Act(string actionType,string? rawInput=null)
    {
        if (_submitting || _session is null)
            return;
        _submitting = true;
        _actionMessage = null;
        _inflightKey ??= Guid.NewGuid();
        try
        {
            using var client=await ApiClient.CreateAsync();
            var payload=new{_session.EventInstanceId,_session.SurvivorId,_session.TimelineId,IdempotencyKey=_inflightKey.Value,
                Action=new{ActionType=actionType,Arguments=new Dictionary<string,string>(),RawInput=rawInput}};
            using var response=await client.PostAsJsonAsync("/api/day1/resolve",payload);
            response.EnsureSuccessStatusCode();
            var result=await response.Content.ReadFromJsonAsync<ResolutionDto>();
            if(result?.Accepted==true)
            {
                _resolutionText = DayOneOutcomes.Text(result.OutcomeKey, result.NarrativeFacts);
                _inflightKey = null;
                _selectedActionType = actionType;
                _beatIndex = Scene.IndexOf("choice-wake");
                await SaveProgressAsync();
            }
            else
            {
                _inflightKey=null;
                _actionMessage = StoryContentPolicy.RetryAction;
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Player action could not be saved");
            _error = ex.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "This Thread changed or this decision is already resolved. Reload, or weave a new Thread to choose differently."
                : "Unable to save your choice. Your session may have expired.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SaveProgressAsync()
    {
        if (_session is null)
            return;
        using var client=await ApiClient.CreateAsync();
        using var response=await client.PostAsJsonAsync("/api/session/progress",new{_session.SurvivorId,_session.EventInstanceId,SceneKey=Scene.Key,BeatKey=Beat.Key});
        response.EnsureSuccessStatusCode();
        if (_artwork is not null)
            await RememberArtwork(_artwork);
    }

    private sealed record SessionDto(Guid SurvivorId,Guid TimelineId,Guid EventInstanceId,int SurvivorDay,string EventKey,string Status,string? LastOutcome,Dictionary<string,string> NarrativeFacts,string SceneKey,string BeatKey);
    private sealed record ResolutionDto(bool Accepted,string OutcomeKey, Dictionary<string,string>? NarrativeFacts);
}

