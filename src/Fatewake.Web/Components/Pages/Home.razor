@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Fatewake — The Silence</PageTitle>
<main class="scene">
  <section class="episode">
    <div class="art-panel" data-artwork="day1-maya-street">
      <div class="panel-label">THE SILENCE · SURVIVOR DAY 1</div>
      <div class="time">6:17 <span>AM</span></div>
      <div class="signal">NO SERVICE</div>
      <div class="caption">
        Your phone has signal bars, but nothing connects. The lights flicker twice, then the house goes quiet. Outside, car alarms wake the neighborhood.
      </div>
      <div class="dialogue">
        <div class="speaker">MAYA TORRES</div>
        <div class="line">“I need help!”</div>
      </div>
    </div>
    @if (!_ready) { <div class="interaction"><div class="wake">REMEMBERING…</div></div> }
    else if (_resolution is null)
    {
      <div class="interaction">
        <div class="choices">
          <button @onclick='() => Act("help_injured_stranger")'>Help Maya</button>
          <button @onclick='() => Act("call_from_safety")'>Call Out</button>
          <button @onclick='() => Act("stay_inside")'>Stay Inside</button>
          <button @onclick='() => Act("investigate_radio")'>Check Radio</button>
        </div>
        <button class="other-toggle" @onclick="() => _showOther = !_showOther">Do something else…</button>
        @if (_showOther) { <div class="composer"><textarea @bind="_freeform" placeholder="What do you do?"></textarea><button disabled="@string.IsNullOrWhiteSpace(_freeform)" @onclick="SubmitFreeform">Do it</button></div> }
      </div>
    }
    else { <section class="result"><p>@_resolutionText</p><div class="wake">Your choice leaves a wake.</div></section> }
  </section>
</main>
