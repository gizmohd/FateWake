@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using Fatewake.Web.Presentation
@using Fatewake.Observability
@implements IAsyncDisposable
@inject Fatewake.Web.Authentication.AuthenticatedApiClient Api
@inject ILogger<RagAdminPanel> Logger
@inject IJSRuntime JS

<main class="rag-admin">
    <header>
        <div class="eyebrow">PATHWEAVER · ADMINISTRATION</div>
        <h1>RAG corpus</h1>
        <p>Upload approved source documents for scene and dialogue context retrieval.</p>
    </header>

    @if (_denied)
    {
        <p role="alert">This interface requires Admin access. <a href="/login">Sign in</a> with an Admin account.</p>
    }
    else
    {
        <section class="rag-upload" aria-labelledby="upload-heading">
            <h2 id="upload-heading">Import document</h2>
            <div class="upload-grid">
                <label>Document
                    <InputFile OnChange="SelectFile" disabled="@_uploading" accept=".txt,.md,.json,.csv,.xml,.yaml,.yml,.html,.htm,.pdf,.docx" />
                </label>
                <label>Source key
                    <input value="@_sourceKey" @onchange="SourceKeyChanged" maxlength="200" placeholder="wayfinder-manuscript-v1" />
                </label>
                <label>Source type
                    <select @bind="_sourceType">
                        <option>Manuscript</option>
                        <option>WorldBible</option>
                        <option>StoryLine</option>
                        <option>GeneratedStory</option>
                        <option>DesignDocument</option>
                        <option>Reference</option>
                    </select>
                </label>
                <label>Title
                    <input value="@_title" @oninput="TitleChanged" maxlength="300" placeholder="The Wayfinder Legacy — Volume One" />
                </label>
                <label>License status
                    <select @bind="_licenseStatus">
                        <option>Authorized</option>
                        <option>InternalReview</option>
                        <option>Restricted</option>
                    </select>
                </label>
                <label>Review status
                    <select @bind="_reviewStatus">
                        <option>PendingReview</option>
                        <option>Approved</option>
                        <option>Rejected</option>
                    </select>
                </label>
                <label>Visibility
                    <select @bind="_visibility">
                        <option>Internal</option>
                        <option>SharedApprovedCanon</option>
                        <option>Private</option>
                    </select>
                </label>
                <label>Timeline key
                    <input value="@_timelineKey" @onchange="TimelineKeyChanged" maxlength="100" placeholder="wayfinder-core" />
                </label>
                <label>Spoiler series
                    <input type="number" min="1" max="20" @bind="_spoilerSeries" />
                </label>
            </div>
            @if (_file is not null)
            {
                <p class="selected-file">Selected: @_file.Name (@FormatBytes(_file.Size))</p>
            }
            <button type="button" disabled="@(_uploading || _file is null || _authenticationRequired)" @onclick="UploadAsync">
                @(_uploading ? "Importing…" : "Upload and import")
            </button>
            @if (_message is not null)
            {
                <p role="status">@_message</p>
            }
            @if (_uploadError is { } uploadError)
            {
                <p role="alert" class="error">@uploadError.Message</p>
                <button type="button" @onclick="() => ShowDetails(uploadError)">Show error details</button>
                @if (uploadError.RequiresAuthentication) { <a href="/login">Sign in again</a> }
            }
        </section>

        <section class="rag-status" aria-labelledby="status-heading">
            <div class="status-heading">
                <h2 id="status-heading">Database status</h2>
                <button type="button" disabled="@_loading" @onclick="RefreshAsync">Refresh</button>
            </div>
            @if (_statusError is { } statusError)
            {
                <p role="alert" class="error">@statusError.Message</p>
                <button type="button" @onclick="() => ShowDetails(statusError)">Show status error details</button>
                @if (statusError.RequiresAuthentication) { <a href="/login">Sign in again</a> }
            }
            @if (_status is { } status)
            {
                <div class="rag-metrics">
                    <article><span>Sources</span><strong>@status.SourceCount</strong></article>
                    <article><span>Documents</span><strong>@status.DocumentCount</strong></article>
                    <article><span>Chunks</span><strong>@status.ChunkCount</strong></article>
                    <article><span>Embedded chunks</span><strong>@status.EmbeddedChunkCount</strong></article>
                    <article><span>Extracted claims</span><strong>@status.ClaimCount</strong></article>
                    <article><span>Approved claims</span><strong>@status.ApprovedClaimCount</strong></article>
                </div>

                <h3>Recent imports</h3>
                @if (status.Runs.Length == 0)
                {
                    <p>No RAG ingestion runs recorded.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr><th>Status</th><th>Phase</th><th>Documents</th><th>Chunks</th><th>Started</th><th>Completed</th><th>Details</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var run in status.Runs)
                                {
                                    <tr>
                                        <td>@run.Status</td>
                                        <td>@run.Phase</td>
                                        <td>@run.DocumentCount</td>
                                        <td>@run.ChunkCount</td>
                                        <td>@run.StartedAt.ToString("u")</td>
                                        <td>@(run.CompletedAt?.ToString("u") ?? "Running")</td>
                                        <td>@(run.ErrorDetail ?? run.EmbeddingModel ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (_loading)
            {
                <p role="status">Loading RAG status…</p>
            }
        </section>
        @if (!_authenticationRequired)
        {
            <RagClaimReviewPanel Changed="RefreshAsync" />
        }
    }
    <dialog @ref="_errorDialog" aria-labelledby="rag-error-title" class="error-dialog">
        <h2 id="rag-error-title">RAG request error details</h2>
        @if (_details is { } details)
        {
            <p>@details.Message</p>
            <dl>
                <dt>Operation</dt><dd>@details.Operation</dd>
                <dt>HTTP status</dt><dd>@(details.StatusCode?.ToString() ?? "No HTTP response")</dd>
                <dt>Error code</dt><dd>@details.Code</dd>
                <dt>Details</dt><dd>@details.Detail</dd>
                <dt>Reference ID</dt><dd>@(details.ReferenceId ?? "Not returned by the API")</dd>
                <dt>Time (UTC)</dt><dd>@details.OccurredAt.ToString("u")</dd>
            </dl>
            @if (details.RequiresAuthentication) { <p><a href="/login">Sign in again</a>, then retry the import.</p> }
        }
        <form method="dialog"><button type="submit" autofocus>Close</button></form>
    </dialog>
</main>

@code {
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private bool _denied;
    private bool _loading;
    private bool _uploading;
    private string _sourceKey = "";
    private string _sourceType = "Manuscript";
    private string _title = "";
    private string _licenseStatus = "Authorized";
    private string _reviewStatus = "PendingReview";
    private string _visibility = "Internal";
    private string _timelineKey = "";
    private bool _sourceKeyEdited, _timelineKeyEdited;

    private void TitleChanged(ChangeEventArgs args)
    {
        _title = args.Value?.ToString() ?? "";
        if (!_sourceKeyEdited)
            _sourceKey = RagKeySlug.FromTitle(_title, 200);
        if (!_timelineKeyEdited)
            _timelineKey = RagKeySlug.FromTitle(_title, 100);
    }

    private void SourceKeyChanged(ChangeEventArgs args)
    {
        _sourceKey = args.Value?.ToString() ?? "";
        _sourceKeyEdited = _sourceKey.Length > 0;
    }

    private void TimelineKeyChanged(ChangeEventArgs args)
    {
        _timelineKey = args.Value?.ToString() ?? "";
        _timelineKeyEdited = _timelineKey.Length > 0;
    }
    private int? _spoilerSeries;
    private IBrowserFile? _file;
    private string? _message;
    private RagRequestError? _uploadError;
    private RagRequestError? _statusError;
    private RagRequestError? _details;
    private bool _authenticationRequired;
    private bool _showDetails;
    private ElementReference _errorDialog;
    private IJSObjectReference? _dialogModule;
    private RagStatusResultDto? _status;

    protected override async Task OnInitializedAsync()
    {
        _denied = !(await Api.GetCurrentUserAsync()).IsInRole("Admin");
        if (!_denied)
        {
            await RefreshAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_denied)
        {
            _poll = PollAsync();
        }
        if (_showDetails)
        {
            _showDetails = false;
            _dialogModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Presentation/RagAdminPanel.razor.js");
            await _dialogModule.InvokeVoidAsync("showErrorDetails", _errorDialog);
        }
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        _file = args.FileCount == 1 ? args.File : null;
        _uploadError = null;
        _message = null;
        if (_file?.Size > 100L * 1024 * 1024)
        {
            _uploadError = new("Upload document", "The selected document is too large.",
                "Choose a non-empty document no larger than 100 MiB.", null, "rag.file_too_large", null, DateTimeOffset.UtcNow);
            _file = null;
        }
    }

    private void ShowDetails(RagRequestError error)
    {
        _details = error;
        _showDetails = true;
    }

    private async Task UploadAsync()
    {
        if (_file is null || _authenticationRequired || _uploading)
        {
            return;
        }
        _uploading = true;
        _message = null;
        _uploadError = null;
        using var operation = OperationTelemetry.Start("web.rag.upload", Logger);
        try
        {
            using var client = await Api.CreateAsync();
            await using var stream = _file.OpenReadStream(100 * 1024 * 1024, _stop.Token);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_file.ContentType ?? "application/octet-stream");
            content.Add(fileContent, "file", _file.Name);
            content.Add(new StringContent(_sourceKey.Trim()), "sourceKey");
            content.Add(new StringContent(_sourceType), "sourceType");
            content.Add(new StringContent(_title.Trim()), "title");
            content.Add(new StringContent(_licenseStatus), "licenseStatus");
            content.Add(new StringContent(_reviewStatus), "reviewStatus");
            content.Add(new StringContent(_visibility), "visibility");
            content.Add(new StringContent(_timelineKey.Trim()), "timelineKey");
            if (_spoilerSeries is { } series)
            {
                content.Add(new StringContent(series.ToString()), "spoilerSeries");
            }
            using var response = await client.PostAsync("/api/admin/rag/import", content, _stop.Token);
            if (!response.IsSuccessStatusCode)
            {
                _uploadError = await RagRequestError.ReadAsync(response, "Upload document", _stop.Token);
                _authenticationRequired = _uploadError.RequiresAuthentication;
                Logger.LogWarning("RAG upload rejected with HTTP {StatusCode}; reference {ReferenceId}",
                    (int)response.StatusCode, _uploadError.ReferenceId);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<RagImportResultDto>(_stop.Token);
            _message = result is null
                ? "Document queued for import."
                : result.ReusedJob
                    ? $"This document import is already queued. Job {result.WorkJobId}."
                    : $"Document queued for Worker import. Job {result.WorkJobId}.";
            await RefreshAsync();
        }
        catch (OperationCanceledException ex) when (_stop.IsCancellationRequested)
        {
            operation.Fail(ex);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or IOException or OperationCanceledException or JSException)
        {
            operation.Fail(ex);
            Logger.LogWarning("RAG upload failed with {ExceptionType}", ex.GetType().FullName);
            _uploadError = LocalError(ex, "Upload document");
            _authenticationRequired = _uploadError.RequiresAuthentication;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_loading || _denied || _authenticationRequired)
        {
            return;
        }
        _loading = true;
        using var operation = OperationTelemetry.Start("web.rag.status", Logger);
        try
        {
            using var client = await Api.CreateAsync();
            using var response = await client.GetAsync("/api/admin/rag/status", _stop.Token);
            if (!response.IsSuccessStatusCode)
            {
                _statusError = await RagRequestError.ReadAsync(response, "Refresh corpus status", _stop.Token);
                _authenticationRequired = _statusError.RequiresAuthentication;
                if (_authenticationRequired) _status = null;
                Logger.LogWarning("RAG status rejected with HTTP {StatusCode}; reference {ReferenceId}",
                    (int)response.StatusCode, _statusError.ReferenceId);
                return;
            }
            _status = await response.Content.ReadFromJsonAsync<RagStatusResultDto>(_stop.Token);
            if (_status is null) throw new System.Text.Json.JsonException("The RAG status response was empty.");
            _statusError = null;
        }
        catch (OperationCanceledException ex) when (_stop.IsCancellationRequested)
        {
            operation.Fail(ex);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or IOException or OperationCanceledException)
        {
            operation.Fail(ex);
            Logger.LogWarning("RAG status refresh failed with {ExceptionType}", ex.GetType().FullName);
            _statusError = LocalError(ex, "Refresh corpus status");
            _authenticationRequired = _statusError.RequiresAuthentication;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (!_stop.IsCancellationRequested && !_authenticationRequired)
            {
                await Task.Delay(TimeSpan.FromSeconds(15), _stop.Token);
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private static RagRequestError LocalError(Exception exception, string operation) =>
        exception is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized }
            ? new(operation, "Your session has no valid API access token. Sign in again.",
                "The signed-in request was blocked before contacting the API.", 401, "rag.sign_in_required", null, DateTimeOffset.UtcNow)
            : new(operation, "The RAG request could not be completed.",
                exception switch
                {
                    OperationCanceledException => "The request timed out. Check connectivity and retry; refresh the corpus status before resubmitting to check whether the import was queued.",
                    System.Text.Json.JsonException => "The API returned an unreadable response. Refresh the corpus status before retrying.",
                    IOException or JSException => "The selected document stream could not be read. Reselect the file and retry.",
                    _ => "The API could not be reached. Check the service status and retry."
                }, null, exception.GetType().Name, System.Diagnostics.Activity.Current?.TraceId.ToString(), DateTimeOffset.UtcNow);

    private static string FormatBytes(long bytes)
    {
        return bytes < 1024 * 1024
            ? $"{bytes / 1024d:N0} KB"
            : $"{bytes / 1024d / 1024d:N1} MB";
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_poll is not null)
        {
            await _poll;
        }
        if (_dialogModule is not null)
        {
            try { await _dialogModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _stop.Dispose();
    }
}
