@using Fatewake.Web.Presentation
@implements IDisposable
@inject Fatewake.Web.Authentication.AuthenticatedApiClient ApiClient
@inject Microsoft.Extensions.Logging.ILogger<ArtCompositionView> Logger
<div class="art-composition" data-artwork="@ArtworkKey">
    @foreach (var layer in Layers.OrderBy(x => x.Z))
    {
        if (ResolvedAssets.GetValueOrDefault(layer.AssetKey) is not { Status: "ready", Version: > 0 } asset ||
            FailedImages.Contains((layer.AssetKey, asset.Version))) continue;
        <picture @key="(layer, asset.Version)" class="art-layer-picture" style="@LayerStyle(layer)">
            <source srcset="@ArtUrl(asset, "webp")" type="image/webp" />
            <img class="art-layer @(layer.AssetKey.StartsWith("bg-", StringComparison.Ordinal) ? "art-background" : "art-overlay")"
                 src="@ArtUrl(asset, "png")" alt="" aria-hidden="true" @onerror="() => RetryImage(asset)" />
        </picture>
    }
    <div class="art-placeholder" aria-hidden="true">
        <img src="/images/art-generating.svg" alt="" />
    </div>
    @if (StatusMessage is {} message)
    {
        <div class="art-generation-status" role="status">@message</div>
    }
    @ChildContent
</div>
<AdminArtReview SceneKey="@ArtworkKey" Versions="@ReviewVersions" ReplacementRequested="ReloadArtwork" />
@code {
    private Dictionary<string, int?> ReviewVersions => Layers.Select(x => x.AssetKey).Distinct()
        .ToDictionary(key => key, key => ResolvedAssets.GetValueOrDefault(key)?.Version);
    private void ReloadArtwork()
    {
        Loading?.Cancel(); Loading?.Dispose(); Loading = new();
        Polling = false;
        FailedImages.Clear();
        StartLoading = true;
    }
    [Parameter,EditorRequired] public string ArtworkKey {get;set;}="";
    [Parameter] public IReadOnlyList<ArtLayer> Layers {get;set;}=[];
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter] public EventCallback<ArtworkSnapshot> ArtworkDisplayed { get; set; }
    [Parameter] public Guid? SurvivorId { get; set; }
    [Parameter] public string[] PrefetchKeys { get; set; } = [];
    [Parameter] public string? SelectedActionType { get; set; }
    private Dictionary<string, SceneAsset> ResolvedAssets = new(StringComparer.Ordinal);
    private readonly HashSet<(string Key, int? Version)> FailedImages = [];
    private static readonly TimeSpan RetryInterval = TimeSpan.FromSeconds(5);
    private CancellationTokenSource? Loading;
    private (string Keys, Guid? Survivor, string? Action)? Signature;
    private bool StartLoading;
    private bool Polling;
    private bool Unavailable;
    private string? StatusMessage => Layers.Count == 0 ? null : Unavailable ? "Artwork is temporarily unavailable. Retrying…"
        : ResolvedAssets.Values.Any(x => x.Status is "failed" or "cancelled") ? "Some artwork could not be generated."
        : ResolvedAssets.Values.Any(x => x.Status == "disabled") ? "Artwork generation is not configured."
        : NeedsRetry ? "Preparing artwork…" : null;

    private bool NeedsRetry => FailedImages.Count > 0 || Layers.Any(layer =>
        ResolvedAssets.GetValueOrDefault(layer.AssetKey) is not
            ({ Status: "ready", Version: > 0 } or { Status: "failed" or "cancelled" or "disabled" }));

    private void RetryImage(SceneAsset asset)
    {
        if (ResolvedAssets.GetValueOrDefault(asset.Key) != asset || !FailedImages.Add((asset.Key, asset.Version))) return;
        if (!Polling) StartLoading = true;
    }

    protected override void OnParametersSet()
    {
        var signature = (string.Join("|", Layers.Select(x => x.AssetKey).Distinct().Order()) + "#" +
            string.Join("|", PrefetchKeys.Distinct(StringComparer.Ordinal).Order()), SurvivorId, SelectedActionType);
        if (signature == Signature) return;
        Signature = signature;
        Loading?.Cancel();
        Loading?.Dispose();
        Loading = new();
        ResolvedAssets = new(StringComparer.Ordinal);
        FailedImages.Clear();
        Polling = false;
        Unavailable = false;
        StartLoading = Layers.Count > 0;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (StartLoading)
        {
            StartLoading = false;
            Polling = true;
            var retryingImage = FailedImages.Count > 0;
            _ = LoadAsync(Layers.Select(x => x.AssetKey).Distinct().ToArray(),
                retryingImage ? [] : PrefetchKeys.Distinct(StringComparer.Ordinal)
                    .Except(Layers.Select(x => x.AssetKey), StringComparer.Ordinal).Take(24).ToArray(),
                retryingImage, Loading!.Token);
        }
        return Task.CompletedTask;
    }

    private async Task LoadAsync(string[] keys, string[] prefetchKeys, bool waitBeforeRequest, CancellationToken ct)
    {
        try
        {
            if (prefetchKeys.Length > 0) _ = PrefetchAsync(prefetchKeys, ct);
            while (!ct.IsCancellationRequested)
            {
                var retrying = FailedImages.ToArray();
                if (waitBeforeRequest) await Task.Delay(RetryInterval, ct);
                waitBeforeRequest = true;
                try
                {
                    using var client = await ApiClient.CreateAsync();
                    using var response = await client.PostAsJsonAsync("/api/art/scene/resolve", new { keys, SurvivorId, SelectedActionType }, ct);
                    response.EnsureSuccessStatusCode();
                    var assets = await response.Content.ReadFromJsonAsync<SceneAsset[]>(ct) ?? [];
                    ct.ThrowIfCancellationRequested();
                    ResolvedAssets = assets.ToDictionary(x => x.Key, StringComparer.Ordinal);
                    FailedImages.ExceptWith(retrying);
                    Unavailable = false;
                }
                catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException && !ct.IsCancellationRequested)
                {
                    if (!Unavailable) Logger.LogWarning(ex, "Visible artwork resolution failed; retrying");
                    Unavailable = true;
                }
                await InvokeAsync(StateHasChanged);
                if (!Unavailable)
                    await InvokeAsync(() => ArtworkDisplayed.InvokeAsync(new ArtworkSnapshot(ArtworkKey, ReviewVersions)));
                if (!Unavailable && !NeedsRetry) return;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally
        {
            if (!ct.IsCancellationRequested) Polling = false;
        }
    }

    private async Task PrefetchAsync(string[] keys, CancellationToken ct)
    {
        try
        {
            using var client = await ApiClient.CreateAsync();
            using var response = await client.PostAsJsonAsync("/api/art/scene/resolve",
                new { keys, SurvivorId, SelectedActionType }, ct);
            response.EnsureSuccessStatusCode();
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Predictive artwork prefetch failed; visible artwork will continue normally");
        }
    }

    public void Dispose() { Loading?.Cancel(); Loading?.Dispose(); }
    private static string ArtUrl(SceneAsset asset, string format) => $"/art/{asset.Key}/{asset.Version}/{format}";
    private sealed record SceneAsset(string Key, string Status, int? Version);
    private static string LayerStyle(ArtLayer x)=>$"z-index:{x.Z};left:{x.X*100:F2}%;top:{x.Y*100:F2}%;width:{x.Width*100:F2}%;height:{x.Height*100:F2}%;opacity:{x.Opacity:F2};transform:translate(-50%,-50%) scale({x.Scale:F3}) rotate({x.Rotation:F2}deg);";
}
