@using Fatewake.Web.Presentation
@implements IDisposable
@inject Fatewake.Web.Authentication.AuthenticatedApiClient ApiClient
@inject Microsoft.Extensions.Logging.ILogger<ArtCompositionView> Logger
@inject SceneArtworkCache ArtworkCache
<div class="art-composition" data-artwork="@ArtworkKey">
    @foreach (var layer in Layers.OrderBy(x => x.Z))
    {
        if (DisplayableAsset(layer.AssetKey) is not { } asset) continue;
        <picture @key="(layer, asset.Version)" class="art-layer-picture" style="@LayerStyle(layer)">
            @{ var character = IsCharacter(layer.AssetKey); }
            @if (!character)
            {
                <source srcset="@ArtUrl(asset, "webp")" type="image/webp" />
            }
            <img class="art-layer @(layer.AssetKey.StartsWith("bg-", StringComparison.Ordinal) ? "art-background" : "art-overlay")"
                 src="@ArtUrl(asset, character ? "sprite-png" : "png")" alt="" aria-hidden="true" @onerror="() => RetryImage(asset)" />
        </picture>
    }
    <div class="art-placeholder" aria-hidden="true">
        <img src="/images/art-generating.svg" alt="" />
    </div>
    @if (StatusMessage is {} message)
    {
        <div class="art-generation-status" role="status">@message</div>
    }
    @ChildContent
</div>
<AdminArtReview SceneKey="@ArtworkKey" Versions="@ReviewVersions" ReplacementRequested="ReloadArtwork" />
<div hidden aria-hidden="true">
    @foreach (var asset in UpcomingAssets)
    {
        var character = IsCharacter(asset.Key);
        <picture @key="(asset.Key, asset.Version)">
            @if (!character)
            {
                <source srcset="@ArtUrl(asset, "webp")" type="image/webp" />
            }
            <img src="@ArtUrl(asset, character ? "sprite-png" : "png")" alt="" fetchpriority="low" />
        </picture>
    }
</div>
@code {
    private Dictionary<string, int?> ReviewVersions => Layers.Select(x => x.AssetKey).Distinct()
        .ToDictionary(key => key, key => ResolvedAssets.GetValueOrDefault(key)?.Version);
    private void ReloadArtwork()
    {
        Loading?.Cancel(); Loading?.Dispose(); Loading = new();
        Polling = false;
        FailedImages.Clear();
        StartLoading = true;
    }
    [Parameter,EditorRequired] public string ArtworkKey {get;set;}="";
    [Parameter] public IReadOnlyList<ArtLayer> Layers {get;set;}=[];
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter] public EventCallback<ArtworkSnapshot> ArtworkDisplayed { get; set; }
    [Parameter] public Guid? SurvivorId { get; set; }
    [Parameter] public Guid? EventInstanceId { get; set; }
    [Parameter] public string? ReachedOutcome { get; set; }
    [Parameter] public string[] PrefetchKeys { get; set; } = [];
    [Parameter] public string? SelectedActionType { get; set; }
    private Dictionary<string, SceneAsset> ResolvedAssets = new(StringComparer.Ordinal);
    private readonly HashSet<(string Key, int? Version)> FailedImages = [];
    private static readonly TimeSpan RetryInterval = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan ReadyPollInterval = TimeSpan.FromSeconds(15);
    private CancellationTokenSource? Loading;
    private (string Artwork, string Keys, string Upcoming, SceneArtworkScope Scope)? Signature;
    private SceneArtworkScope Scope => new(SurvivorId, EventInstanceId, SelectedActionType, ReachedOutcome);
    private string[] UpcomingKeys => PrefetchKeys.Distinct(StringComparer.Ordinal)
        .Except(Layers.Select(layer => layer.AssetKey), StringComparer.Ordinal).Take(24).ToArray();
    private IEnumerable<SceneAsset> UpcomingAssets => UpcomingKeys.Select(key => ArtworkCache.Find(Scope, key))
        .OfType<SceneAsset>().Take(6);
    private bool StartLoading;
    private bool Polling;
    private bool Unavailable;
    private string? StatusMessage => Layers.Count == 0 ? null : Unavailable ? "Artwork is temporarily unavailable. Retrying…"
        : ResolvedAssets.Values.Any(x => x.Status is "failed" or "cancelled") ? "Some artwork could not be generated."
        : ResolvedAssets.Values.Any(x => x.Status == "prompt-disabled") ? "An artwork prompt is unavailable. AI prompt authoring is disabled."
        : ResolvedAssets.Values.Any(x => x.Status == "disabled") ? "The artwork renderer is not configured."
        : NeedsRetry && !Layers.Any(layer => layer.AssetKey.StartsWith("bg-", StringComparison.Ordinal) &&
            DisplayableAsset(layer.AssetKey) is not null) ? "Preparing artwork…" : null;

    private SceneAsset? DisplayableAsset(string key) =>
        ResolvedAssets.GetValueOrDefault(key) is { Status: "ready", Version: > 0 } asset &&
        !FailedImages.Contains((key, asset.Version)) ? asset : null;

    private bool NeedsRetry => FailedImages.Count > 0 || ResolvedAssets.Values.Any(asset => asset.ReplacementPending) ||
        Layers.Any(layer =>
        ResolvedAssets.GetValueOrDefault(layer.AssetKey) is not
            ({ Status: "ready", Version: > 0 } or { Status: "failed" or "cancelled" or "disabled" or "prompt-disabled" }));

    private void RetryImage(SceneAsset asset)
    {
        if (ResolvedAssets.GetValueOrDefault(asset.Key) != asset || !FailedImages.Add((asset.Key, asset.Version))) return;
        ArtworkCache.Invalidate(Scope, asset);
        if (!Polling) StartLoading = true;
    }

    protected override void OnParametersSet()
    {
        var signature = (ArtworkKey, string.Join("|", Layers.Select(x => x.AssetKey).Distinct().Order()),
            string.Join("|", UpcomingKeys), Scope);
        if (signature == Signature) return;
        Signature = signature;
        Loading?.Cancel();
        Loading?.Dispose();
        Loading = new();
        ResolvedAssets = Layers.Select(layer => layer.AssetKey).Distinct(StringComparer.Ordinal)
            .Select(key => ArtworkCache.Find(Scope, key)).OfType<SceneAsset>()
            .ToDictionary(asset => asset.Key, StringComparer.Ordinal);
        FailedImages.Clear();
        Polling = false;
        Unavailable = false;
        StartLoading = Layers.Count > 0;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (StartLoading)
        {
            StartLoading = false;
            Polling = true;
            var retryingImage = FailedImages.Count > 0;
            _ = LoadAsync(Layers.Select(x => x.AssetKey).Distinct().ToArray(),
                retryingImage ? [] : UpcomingKeys, Scope, ArtworkKey, retryingImage, Loading!.Token);
        }
        return Task.CompletedTask;
    }

    private async Task LoadAsync(string[] keys, string[] prefetchKeys, SceneArtworkScope scope, string artworkKey,
        bool waitBeforeRequest, CancellationToken ct)
    {
        try
        {
            var confirmed = false;
            var nextReadyPoll = DateTimeOffset.MinValue;
            while (!ct.IsCancellationRequested)
            {
                if (waitBeforeRequest) await Task.Delay(RetryInterval, ct);
                waitBeforeRequest = true;
                if (!Unavailable && !NeedsRetry && DateTimeOffset.UtcNow < nextReadyPoll)
                    continue;
                var retrying = FailedImages.ToArray();
                var changed = false;
                try
                {
                    using var client = await ApiClient.CreateAsync();
                    using var response = await client.PostAsJsonAsync("/api/art/scene/resolve",
                        new { keys, SurvivorId = scope.Survivor, SelectedActionType = scope.Action }, ct);
                    response.EnsureSuccessStatusCode();
                    var assets = await response.Content.ReadFromJsonAsync<SceneAsset[]>(ct) ?? [];
                    ct.ThrowIfCancellationRequested();
                    var resolved = assets.ToDictionary(x => x.Key, StringComparer.Ordinal);
                    changed = !confirmed || Unavailable || retrying.Length > 0 || resolved.Count != ResolvedAssets.Count ||
                        resolved.Any(pair => pair.Value != ResolvedAssets.GetValueOrDefault(pair.Key));
                    foreach (var asset in assets)
                        ArtworkCache.Update(scope, asset);
                    ResolvedAssets = resolved;
                    FailedImages.ExceptWith(retrying);
                    Unavailable = false;
                    nextReadyPoll = DateTimeOffset.UtcNow.Add(ReadyPollInterval);
                    if (!confirmed && prefetchKeys.Length > 0)
                        _ = PrefetchAsync(prefetchKeys, scope, ct);
                    confirmed = true;
                }
                catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException && !ct.IsCancellationRequested)
                {
                    changed = !Unavailable;
                    if (!Unavailable) Logger.LogWarning(ex, "Visible artwork resolution failed; retrying");
                    Unavailable = true;
                }
                if (changed)
                {
                    await InvokeAsync(StateHasChanged);
                    if (!Unavailable && !ct.IsCancellationRequested)
                        await InvokeAsync(() => ArtworkDisplayed.InvokeAsync(new ArtworkSnapshot(artworkKey, ReviewVersions)));
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally
        {
            if (!ct.IsCancellationRequested) Polling = false;
        }
    }

    private async Task PrefetchAsync(string[] keys, SceneArtworkScope scope, CancellationToken ct)
    {
        try
        {
            using var client = await ApiClient.CreateAsync();
            using var response = await client.PostAsJsonAsync("/api/art/scene/resolve",
                new { keys, SurvivorId = scope.Survivor, SelectedActionType = scope.Action }, ct);
            response.EnsureSuccessStatusCode();
            var assets = await response.Content.ReadFromJsonAsync<SceneAsset[]>(ct) ?? [];
            ct.ThrowIfCancellationRequested();
            foreach (var asset in assets)
                ArtworkCache.Update(scope, asset);
            if (assets.Any(asset => asset.IsReady))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Predictive artwork prefetch failed; visible artwork will continue normally");
        }
    }

    public void Dispose() { Loading?.Cancel(); Loading?.Dispose(); }
    private static bool IsCharacter(string key) => key.StartsWith("char-", StringComparison.Ordinal);
    private static string ArtUrl(SceneAsset asset, string format) => $"/art/{asset.Key}/{asset.Version}/{format}";
    private static string LayerStyle(ArtLayer x)=>$"z-index:{x.Z};left:{x.X*100:F2}%;top:{x.Y*100:F2}%;width:{x.Width*100:F2}%;height:{x.Height*100:F2}%;opacity:{x.Opacity:F2};transform:translate(-50%,-50%) scale({x.Scale:F3}) rotate({x.Rotation:F2}deg);";
}
