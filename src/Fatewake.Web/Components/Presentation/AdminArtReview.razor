@using System.Net
@using Fatewake.Web.Authentication
@using Fatewake.Web.Presentation
@inject AuthenticatedApiClient ApiClients
@if (Allowed)
{
    <details class="art-review-panel">
        <summary>Review artwork · Pathweaver art review · Admin</summary>
        <p>Review the displayed artwork or queue a replacement.</p>
        <div class="review-layer-grid">
            @foreach (var layer in Versions.Where(x => x.Value is not null))
            {
                <button type="button" class="review-layer" @onclick="() => SelectLayerAsync(layer.Key)">
                    <img src="@($"/art/{layer.Key}/{layer.Value}/webp")" alt="@layer.Key" />
                    <span>@layer.Key · v@layer.Value</span>
                </button>
            }
        </div>
        <label>Review target
            <select @bind="Target" @bind:after="TargetChangedAsync">
                <option value="">Complete composition</option>
                @foreach (var layer in Versions.Where(x => x.Value is not null))
                {
                    <option value="@layer.Key">@layer.Key · v@layer.Value</option>
                }
            </select>
        </label>
        @if (!string.IsNullOrEmpty(Target) && Prompt is not null)
        {
            <section class="prompt-provenance">
                <h3>Original generation submission · @Target v@Versions.GetValueOrDefault(Target)</h3>
                @if (Prompt.OriginalSubmissionAvailable)
                {
                    <p><strong>@Prompt.OriginalProvider / @Prompt.OriginalModel</strong> · submitted @Prompt.OriginalSubmittedAt?.ToString("u")</p>
                    <label>Exact positive request submitted
                        <textarea readonly rows="5" value="@Prompt.OriginalResolvedPrompt"></textarea>
                    </label>
                    <label>Exact negative request submitted
                        <textarea readonly rows="3" value="@Prompt.OriginalNegativePrompt"></textarea>
                    </label>
                    <small>Prompt revision: @(Prompt.OriginalPromptRevisionId?.ToString() ?? "legacy provenance unlinked") · source: @(Prompt.OriginalPromptSource ?? "unavailable") · provider job: @(Prompt.OriginalProviderJobId ?? "unavailable")</small>
                }
                else
                {
                    <p>Original prompt provenance is unavailable for this historical image version; no prompt is inferred or reconstructed.</p>
                }
                @if (Prompt.LatestRevisionId is not null)
                {
                    <label>Editable positive prompt for new revision
                        <textarea @bind="PromptPositive" maxlength="8000" rows="4" />
                    </label>
                    <label>Editable negative prompt for new revision
                        <textarea @bind="PromptNegative" maxlength="2000" rows="3" />
                    </label>
                    <p><strong>Enforced shared style</strong><br />@Prompt.EnforcedStyle</p>
                    <p><strong>Enforced role, framing, continuity and exclusions</strong><br />@Prompt.Framing<br />@Prompt.EnforcedExclusions</p>
                    <button type="button" disabled="@(Busy || string.IsNullOrWhiteSpace(PromptPositive))" @onclick="PreviewPromptAsync">Preview final provider request</button>
                    @if (Preview is not null)
                    {
                        <label>Final positive request preview
                            <textarea readonly rows="6" value="@Preview.PreviewResolvedPrompt"></textarea>
                        </label>
                        <label>Final negative request preview
                            <textarea readonly rows="3" value="@Preview.PreviewNegativePrompt"></textarea>
                        </label>
                    }
                    <button type="button" disabled="@(Busy || string.IsNullOrWhiteSpace(PromptPositive))" @onclick="() => SavePromptAsync(false)">Save new revision only</button>
                    <p>Saving a revision does not regenerate art or change the currently served prompt.</p>
                    <button type="button" class="danger" disabled="@(Busy || string.IsNullOrWhiteSpace(PromptPositive))" @onclick="() => SavePromptAsync(true)">Regenerate selected image (uses generation credits)</button>
                    @if (Prompt.ReplacementStatus is not null)
                    {
                        <p role="status">Replacement: @Prompt.ReplacementStatus @(Prompt.ReplacementWorkJobId is { } job ? $"· job {job}" : "") @(Prompt.ReplacementVersion is { } version ? $"· v{version}" : "")</p>
                    }
                }
            </section>
        }
        else if (!string.IsNullOrEmpty(Target))
        {
            <p>Loading exact prompt provenance…</p>
        }
        <label>Critique
            <textarea @bind="Critique" @bind:event="oninput" maxlength="4000" rows="3" placeholder="For example: Michelle is a cropped portrait, but she should be supporting the injured man." />
        </label>
        <label class="review-checkbox">
            <input type="checkbox" @bind="UseForFutureArtwork" /> Use this critique to guide future artwork
        </label>
        <button type="button" disabled="@(Busy || !HasRenderedTarget || string.IsNullOrWhiteSpace(Critique))"
                @onclick="() => SaveAsync(false)">Save critique only</button>
        <button type="button" disabled="@(Busy || !HasRenderedTarget)" @onclick="() => SaveAsync(true)">
            @(string.IsNullOrEmpty(Target) ? "Regenerate scene artwork" : "Regenerate selected layer")
        </button>
        @if (string.IsNullOrEmpty(Target))
        {
            <p>Regenerates each rendered layer using the critique. Layer positions follow the scene’s authored layout.</p>
        }
        @if (Message is not null) { <p role="status">@Message</p> }
        @if (SignInRequired) { <a href="/login">Sign in again</a> }
        @if (History.Length > 0)
        {
            <h3>Review history</h3>
            @foreach (var item in History)
            {
                <article>
                    <strong>@(item.AssetKey ?? "Complete composition") @(item.Version is {} version ? $"· v{version}" : "")</strong>
                    <p>@item.Critique</p>
                    <small>@item.CreatedAt.ToString("u") · @(item.Regenerate ? "Replacement requested" : "Critique saved") @(item.UseForFutureArtwork ? "· Used to guide future artwork" : "")</small>
                </article>
            }
        }
    </details>
}
@code {
    [Parameter] public string SceneKey { get; set; } = "";
    [Parameter] public Dictionary<string, int?> Versions { get; set; } = [];
    [Parameter] public EventCallback ReplacementRequested { get; set; }
    private bool Allowed, Busy, SignInRequired;
    private bool UseForFutureArtwork = true;
    private bool HasRenderedTarget => string.IsNullOrEmpty(Target)
        ? Versions.Values.Any(version => version is > 0)
        : Versions.GetValueOrDefault(Target) is > 0;
    private string? LoadedScene, Message;
    private string Target = "", Critique = "", PromptPositive = "", PromptNegative = "";
    private ArtPromptReviewSaveResult? Preview;
    private ArtPromptReviewResponse? Prompt;
    private Review[] History = [];
    protected override async Task OnParametersSetAsync()
    {
        if (LoadedScene == SceneKey) return;
        LoadedScene = SceneKey;
        Target = Critique = PromptPositive = PromptNegative = "";
        Preview = null;
        Prompt = null;
        Allowed = false;
        UseForFutureArtwork = true;
        SignInRequired = false;
        Message = null;
        await LoadHistoryAsync();
    }
    private async Task SelectLayerAsync(string key) { Target = key; await LoadPromptAsync(); }
    private async Task TargetChangedAsync() { await LoadPromptAsync(); }
    private async Task LoadHistoryAsync()
    {
        try
        {
            using var client = await ApiClients.CreateAsync();
            using var response = await client.GetAsync($"/api/art/reviews?sceneKey={Uri.EscapeDataString(SceneKey)}");
            Allowed = response.IsSuccessStatusCode;
            if (Allowed) History = await response.Content.ReadFromJsonAsync<Review[]>() ?? [];
        }
        catch (HttpRequestException) { Allowed = false; }
    }
    private async Task SaveAsync(bool regenerate)
    {
        if (Busy || !HasRenderedTarget)
            return;
        Busy = true; Message = null; SignInRequired = false;
        var snapshot = new Dictionary<string, int?>(Versions);
        var asset = string.IsNullOrEmpty(Target) ? null : Target;
        try
        {
            using var client = await ApiClients.CreateAsync();
            using var response = await client.PostAsJsonAsync("/api/art/reviews", new { SceneKey, AssetKey = asset,
                Version = asset is null ? (int?)null : snapshot.GetValueOrDefault(asset), Versions = snapshot, Critique,
                Correction = (string?)null, Regenerate = regenerate, UseForFutureArtwork });
            if (!response.IsSuccessStatusCode)
            {
                await SetReviewErrorAsync(response, "The critique could not be saved. Refresh the scene and try again.");
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<ReviewSaveResult>();
            Message = regenerate ? $"Queued {result?.JobIds?.Length ?? 0} artwork replacements."
                : result?.UseForFutureArtwork == true ? "Critique saved as an artwork preference." : "Critique saved.";
            await LoadHistoryAsync();
            Critique = "";
            if (regenerate) await ReplacementRequested.InvokeAsync();
        }
        catch (HttpRequestException ex) { SetReviewError(ex.StatusCode, "The review service is unavailable. Try again."); }
        finally { Busy = false; }
    }
    private async Task LoadPromptAsync()
    {
        Prompt = null;
        Preview = null;
        PromptPositive = PromptNegative = "";
        if (string.IsNullOrEmpty(Target) || Versions.GetValueOrDefault(Target) is not { } version) return;
        try
        {
            using var client = await ApiClients.CreateAsync();
            using var response = await client.GetAsync($"/api/art/reviews/prompt?assetKey={Uri.EscapeDataString(Target)}&version={version}");
            if (!response.IsSuccessStatusCode) { Message = "Prompt provenance could not be loaded."; return; }
            Prompt = await response.Content.ReadFromJsonAsync<ArtPromptReviewResponse>();
            PromptPositive = Prompt?.EditablePositivePrompt ?? "";
            PromptNegative = Prompt?.EditableNegativePrompt ?? "";
        }
        catch (HttpRequestException) { Message = "The review service is unavailable. Try again."; }
    }
    private async Task PreviewPromptAsync()
    {
        if (Prompt?.LatestRevisionId is not { } expected || Versions.GetValueOrDefault(Target) is not { } version) return;
        Busy = true;
        try
        {
            using var client = await ApiClients.CreateAsync();
            using var response = await client.PostAsJsonAsync("/api/art/reviews/prompt/preview",
                new ArtPromptReviewRequest(SceneKey, Target, version, expected, PromptPositive, PromptNegative, false));
            if (!response.IsSuccessStatusCode) { Message = "The prompt changed or preview could not be created. Reload the selected layer."; return; }
            Preview = await response.Content.ReadFromJsonAsync<ArtPromptReviewSaveResult>();
            Message = "Preview includes enforced server style, role, framing and continuity requirements.";
        }
        catch (HttpRequestException) { Message = "The review service is unavailable. Try again."; }
        finally { Busy = false; }
    }
    private async Task SavePromptAsync(bool regenerate)
    {
        if (Prompt?.LatestRevisionId is not { } expected || Versions.GetValueOrDefault(Target) is not { } version) return;
        Busy = true; Message = null; SignInRequired = false;
        try
        {
            using var client = await ApiClients.CreateAsync();
            using var response = await client.PostAsJsonAsync("/api/art/reviews/prompt",
                new ArtPromptReviewRequest(SceneKey, Target, version, expected, PromptPositive, PromptNegative, regenerate));
            if (!response.IsSuccessStatusCode)
            {
                await SetReviewErrorAsync(response, "The prompt revision could not be saved. Reload the selected layer.");
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<ArtPromptReviewSaveResult>();
            Message = regenerate ? "Revision saved; replacement for the selected version is queued." : "New prompt revision saved; serving bindings are unchanged.";
            Preview = saved;
            await LoadPromptAsync();
            await LoadHistoryAsync();
            if (regenerate) await ReplacementRequested.InvokeAsync();
        }
        catch (HttpRequestException ex) { SetReviewError(ex.StatusCode, "The review service is unavailable. Try again."); }
        finally { Busy = false; }
    }

    private async Task SetReviewErrorAsync(HttpResponseMessage response, string fallback)
    {
        if (response.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Conflict)
        {
            try
            {
                var error = await response.Content.ReadFromJsonAsync<ReviewError>();
                fallback = error?.Error ?? fallback;
            }
            catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException) { }
        }
        SetReviewError(response.StatusCode, fallback);
    }

    private void SetReviewError(HttpStatusCode? status, string fallback)
    {
        SignInRequired = status == HttpStatusCode.Unauthorized;
        Message = status switch
        {
            HttpStatusCode.Unauthorized => "Your API session expired. Sign in again to submit this review.",
            HttpStatusCode.Forbidden => "This account does not have artwork review permission.",
            _ => fallback
        };
    }

    private sealed record ReviewError(string Error);
    private sealed record ReviewSaveResult(Guid[]? JobIds, bool UseForFutureArtwork);
    private sealed record Review(string? AssetKey, int? Version, string Critique, bool Regenerate,
        DateTimeOffset CreatedAt, bool UseForFutureArtwork);
}
