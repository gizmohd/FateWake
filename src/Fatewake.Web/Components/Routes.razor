<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* Interactive player pages own their shell so navigation follows the selected session. *@
        <RouteView RouteData="routeData" DefaultLayout="@(routeData.PageType == typeof(Pages.Home) || routeData.PageType == typeof(Pages.Timelines) || routeData.PageType == typeof(Pages.UniverseMap) ? null : typeof(SiteLayout))" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(SiteLayout)">
            <main class="account-page"><h1>Page not found</h1></main>
        </LayoutView>
    </NotFound>
</Router>
