<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* Play renders the same shell inside its interactive page so its chapter and menu can follow the session. *@
        <RouteView RouteData="routeData" DefaultLayout="@(routeData.PageType == typeof(Pages.Home) ? null : typeof(SiteLayout))" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(SiteLayout)">
            <main class="account-page"><h1>Page not found</h1></main>
        </LayoutView>
    </NotFound>
</Router>
