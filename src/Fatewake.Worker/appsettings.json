{
  "ArtStorage": {
    "Provider": "Postgres",
    "RootPath": ""
  },
  "ArtGeneration": {
    "Provider": "None",
    "OpenAI": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1/",
      "Model": "gpt-image-2.5-sunburst",
      "Size": "1536x1024",
      "Quality": "high",
      "FallbackModel": "gpt-image-2.6-flare",
      "FallbackQuality": "low",
      "FallbackComplexity": "low",
      "Background": "opaque"
    },
    "Local": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "http://localhost:11434/v1/",
      "Model": "local-image",
      "Size": "1536x1024",
      "Quality": "high"
    },
    "ComfyUI": {
      "Enabled": true,
      "BaseUrl": "https://cloud.comfy.org",
      "ApiKey": "",
      "WorkflowPath": "workflows/fatewake-api.json",
      "PromptToken": "__FATEWAKE_PROMPT__",
      "NegativePromptToken": "__FATEWAKE_NEGATIVE__",
      "SeedToken": "__FATEWAKE_SEED__",
      "ReferenceTokenPrefix": "__FATEWAKE_REFERENCE_",
      "PollIntervalMilliseconds": 1000,
      "TimeoutSeconds": 300
    }
  },
  "ArtPromptAuthoring": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-6-luna",
    "ReasoningEffort": "none",
    "TimeoutSeconds": 90,
    "MaximumOutputTokens": 1200
  },
  "Embedding": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "text-embedding-3-small",
    "Dimensions": 1024,
    "BatchSize": 32,
    "TimeoutSeconds": 60,
    "PollIntervalSeconds": 10
  },
  "SceneAuthoring": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-6-luna",
    "ReasoningEffort": "low",
    "TimeoutSeconds": 120,
    "MaximumOutputTokens": 4000,
    "RetrievalLimit": 8
  },
  "Work": {
    "QueueConcurrency": {
      "art.generate": 1,
      "art.encode": 2,
      "art.validate": 2,
      "art.finalize": 1,
      "art.prompt-author": 1,
      "rag.import": 1,
      "story.scene": 1,
      "narrative.render": 2,
      "maintenance": 1
    }
  }
}
