{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__FATEWAKE_PROMPT__", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__FATEWAKE_NEGATIVE__", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 768, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
      "seed": __FATEWAKE_SEED__, "steps": 20, "cfg": 7.0,
      "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "images": ["11", 0], "filename_prefix": "Fatewake" }
  }
,
  "8": { "class_type": "LoadBackgroundRemovalModel", "inputs": { "bg_removal_name": "birefnet.safetensors" } },
  "9": { "class_type": "RemoveBackground", "inputs": { "bg_removal_model": ["8", 0], "image": ["6", 0] } },
  "10": { "class_type": "InvertMask", "inputs": { "mask": ["9", 0] } },
  "11": { "class_type": "JoinImageWithAlpha", "inputs": { "image": ["6", 0], "alpha": ["10", 0] } }
}
